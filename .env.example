PORT=3000
NODE_ENV=development

# SQLite (по умолчанию)
DATABASE_URL="file:./dev.db"
# PostgreSQL: замените provider в prisma/schema.prisma на "postgresql"
# DATABASE_URL="postgresql://user:password@localhost:5432/blog?schema=public"

# Секреты JWT — в production замените на длинные случайные строки
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Чат (Socket.io)
# Разрешённые origin для WebSocket-подключений, через запятую (пусто — только тот же origin)
CLIENT_ORIGIN=http://localhost:3000
CHAT_HISTORY_LIMIT=50
CHAT_MAX_MESSAGE_LENGTH=1000
